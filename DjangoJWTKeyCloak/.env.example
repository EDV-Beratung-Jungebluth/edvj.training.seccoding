# Vorlage – Datei nach .env kopieren und Werte ausfüllen.
# Die echte .env ist in .gitignore und wird NICHT eingecheckt.

# Django
SECRET_KEY=aendere-mich-mit-einem-langen-zufaelligen-wert
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Keycloak OIDC (Werte aus dem Realm-Import oder Admin-Konsole)
OIDC_RP_CLIENT_ID=django-app
OIDC_RP_CLIENT_SECRET=aendere-mich-keycloak-client-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=demo

# Keycloak Admin (nur für Docker-Start, nicht von Django genutzt)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
