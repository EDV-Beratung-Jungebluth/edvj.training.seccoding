@page
@model XssDemoModel
@{
    ViewData["Title"] = "XSS Demo";
}
<!-- Demo-Seite: Zeigt Unterschied zwischen unsicherer (Html.Raw) und sicherer (automatisch encodierter) Ausgabe.
     Nur zu Schulungszwecken. Niemals ungeprüftes Benutzerinput mit Html.Raw rendern. -->
<h1>XSS Demonstration</h1>
<form method="get">
    <div class="form-group">
        <label for="input">Eingabe (z.B. &lt;script&gt;alert('XSS')&lt;/script&gt; )</label>
        <input id="input" name="input" value="@Model.Input" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Absenden</button>
</form>
<hr />
<h3>Unsichere Ausgabe (führt eingefügtes Script aus) - NICHT SO IMPLEMENTIEREN</h3>
<div class="border p-2" style="min-height:40px; background:#ffe6e6">
    @* UNSICHER: Html.Raw rendert ohne Encoding *@
    @if (!string.IsNullOrEmpty(Model.Input)) { @Html.Raw(Model.Input) }
</div>
<h3>Sichere Ausgabe (automatisch HTML-encodiert)</h3>
<div class="border p-2" style="min-height:40px; background:#e6ffe6">
    @Model.Input
</div>
<p class="mt-3 text-muted">Vergleich: Oben (unsicher) wird Benutzerinput direkt interpretiert, unten (sicher) als Text angezeigt.</p>
